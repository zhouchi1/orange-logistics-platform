FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="Orange Logistics Platform"

WORKDIR /app

COPY orange-logistics-service/target/orange-logistics-service-1.0.0-SNAPSHOT.jar app.jar

EXPOSE 8080

ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
