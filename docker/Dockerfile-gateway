FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="Orange Logistics Platform"

WORKDIR /app

COPY orange-logistics-gateway/target/orange-logistics-gateway-1.0.0-SNAPSHOT.jar app.jar

EXPOSE 8888

ENV JAVA_OPTS="-Xms128m -Xmx256m -XX:+UseG1GC"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
